# Copy to .env and edit.
SECRET_KEY=change-me-to-a-long-random-string

# MySQL (project requirement). Use the same user/password you use in MySQL Workbench.
# Special characters in the password are fine. Then run: python setup_mysql.py ; python seed.py
MYSQL_USER=root
MYSQL_PASSWORD=your-workbench-password
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=smart_waste
# Alternatively set a full DATABASE_URL. If neither is set, SQLite (instance/waste.db) is used.

# Initial admin account created by `python seed.py`
ADMIN_EMAIL=admin@smartwaste.local
ADMIN_PASSWORD=Admin@12345
