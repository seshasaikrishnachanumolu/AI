# SmartWaste AI settings.
# `setup_windows.bat` (or `python scripts/first_run.py`) creates a ready-to-use .env from this file for you,
# with a random SECRET_KEY and a random admin password. You normally do not need to edit anything.
# Never commit or share your .env file.

SECRET_KEY=change-me-to-a-long-random-string

# ---- Database ---------------------------------------------------------------------------------
# Default: a local SQLite file (instance/waste.db). Nothing to install.
# To use MySQL instead (recommended for real use): uncomment the lines below, type YOUR MySQL
# password, then run   python setup_mysql.py   and   python seed.py
# MYSQL_USER=root
# MYSQL_PASSWORD=your-mysql-password
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_DATABASE=smart_waste
# (Or use one full URL instead:  DATABASE_URL=mysql+pymysql://user:password@localhost:3306/smart_waste )

# ---- First administrator ----------------------------------------------------------------------
# Used by seed.py only while the admin account does not exist yet. Change the password!
ADMIN_EMAIL=admin@smartwaste.local
ADMIN_PASSWORD=Admin@12345
